# Run Properties
RunFlag                 test_1         % name of the run
OutputList              outputs        % output list
BoxSize                     3870.0         % physical size of the box in Mpc
BoxInH100                              % specify that the box is in Mpc/h
GridSize                   2160           % number of grid points per side
RandomSeed              230            % random seed for initial conditions
%FixedIC                None           % if present, the modulus in ICs is fixed to the average
%PairedIC               None           % if present, the phase in ICs is shifted by PI

# Cosmology
Omega0                  0.5            % Omega_0 (CDM + Baryons)
OmegaLambda             0.5            % OmegaLambda
OmegaBaryon             0.049          % Omega_b (baryonic matter)
Hubble100               0.8            % little h
Sigma8                  0.0            % sigma8; if 0, it is computed from the provided P(k)
PrimordialIndex         0.96           % n_s
DEw0                    -1.0           % w0 of parametric dark energy equation of state
DEwa                    0.0            % wa of parametric dark energy equation of state
TabulatedEoSfile        no             % equation of state of dark energy tabulated in a file
FileWithInputSpectrum   pk_camb_z0_highbound.dat

# From N-GenIC
InputSpectrum_UnitLength_in_cm 0       % units of tabulated P(k), or 0 if it is in h/Mpc
WDM_PartMass_in_kev     0.0            % WDM cut following Bode, Ostriker & Turok (2001)

# Control of Memory Requirements
BoundaryLayerFactor     2.5            % width of the boundary layer for fragmentation
MaxMem                       31000           % max available memory to an MPI task in Mbyte
MaxMemPerParticle 350            % max available memory in bytes per particle
PredPeakFactor          1.0            % guess for the number of peaks in the subvolume

# Output
%CatalogInAscii                        % catalogs are written in ascii and not in binary format
OutputInH100                           % units are in H=100 instead of the true H value
NumFiles                1              % number of files in which each catalog is written
MinHaloMass             10             % smallest halo that is given in output
AnalyticMassFunction    9              % form of analytic mass function given in the .mf.out files

# Output options
%WriteTimelessSnapshot  None           % writes a Gadget2 snapshot as an output
%DoNotWriteCatalogs     None           % skips the writing of full catalogs (including PLC)
%DoNotWriteHistories    None           % skips the writing of merger histories

# Past Light Cone
StartingzForPLC         2.0            % starting (highest) redshift for the past light cone
LastzForPLC             0.0            % final (lowest) redshift for the past light cone
PLCAperture             70.0           % cone aperture for the past light cone
%PLCProvideConeData                    % read vertex and direction of cone from paramter file
%PLCCenter                             % cone vertex in the same coordinates as the BoxSize
%PLCAxis                               % un-normalized direction of the cone axis
%MassMapNSIDE            2048           % NSIDE for healpix mass maps

# Table of collapseTime file, needed if the code is compiled with TABULATED_CT
%CTtableFile            None

# CAMB Pk files, needed if the code is compiled with READ_PK_TABLE
%CAMBMatterFile         matterpower    % label for matter power spectrum files (CDM+Baryons)
%CAMBTransferFileTag    transfer_out
%CAMBRunName            nilcdm_0.3eV   % name of the CAMB run
%CAMBRedshiftsFile      inputredshift  % list of redshifts for the Pk table
%CAMBHubbleTableFile    hubble.dat     % Hubble table file

% Set up GPU-GPU communication in HeFFTe (when GPU offloading is active!)
% GPUDirect 	 	       	  	% dangerous, keep it commented for now